<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
<meta name="theme-color" content="#04070F" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<title>Hunter Protocol</title>
<link rel="manifest" href="manifest.json" />
<link rel="icon" href="icons/icon-192.png" />
<link rel="apple-touch-icon" href="icons/icon-192.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">
<style>
:root{
  --void:#04070F; --panel:rgba(8,18,34,0.92); --line:#1B3A5C;
  --cyan:#3FD9FF; --cyanDim:#1E7FA8; --ice:#CFEFFF; --dim:#6C93B0;
  --danger:#FF3B5C; --gold:#F5C542; --green:#43F5A0;
}
*{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
html,body{margin:0;padding:0;background:var(--void);height:100%;overscroll-behavior:none;}
body{
  font-family:'Rajdhani','Segoe UI',system-ui,sans-serif;
  color:var(--ice);
  min-height:100vh; min-height:100dvh;
  display:flex; justify-content:center;
  background:radial-gradient(ellipse at 50% -10%, #0A1B33 0%, var(--void) 55%);
}
.mono{font-family:'Share Tech Mono','Courier New',monospace;}
#frame{
  width:100%; max-width:460px; min-height:100vh; min-height:100dvh;
  display:flex; flex-direction:column; position:relative; overflow:hidden;
  padding-top:env(safe-area-inset-top); padding-bottom:env(safe-area-inset-bottom);
}
.scan{pointer-events:none;position:absolute;inset:0;z-index:1;
  background:repeating-linear-gradient(0deg, transparent 0 2px, rgba(63,217,255,0.018) 2px 4px);}
header.hdr{display:flex;justify-content:space-between;align-items:center;padding:20px 18px 12px;position:relative;z-index:2;}
.eyebrow{font-size:9px;letter-spacing:3px;color:var(--dim);margin-bottom:4px;font-family:'Share Tech Mono',monospace;}
.title{font-size:16px;letter-spacing:2px;font-weight:700;}
.rankBadge{border:1px solid; padding:6px 14px; display:flex;flex-direction:column;align-items:center; background:var(--panel);}
.rankLbl{font-size:8px;letter-spacing:2px;color:var(--dim);}
.rankVal{font-size:30px;font-weight:700;line-height:1;}
.countStrip{margin:0 18px 14px; border:1px solid var(--line); background:var(--panel);
  display:flex;flex-direction:column;align-items:center;padding:8px 0 10px;gap:2px; position:relative;z-index:2;}
.countLbl{font-size:10px;letter-spacing:2px;color:var(--dim);}
.countVal{font-size:22px;color:var(--ice);}
.countWarn{font-size:9px;letter-spacing:1.5px;color:var(--dim);}
main.body{flex:1; padding:0 18px 100px; overflow-y:auto; position:relative; z-index:2;}
.window{position:relative;border:1px solid; background:var(--panel); padding:16px 16px 18px; backdrop-filter:blur(4px); animation:winin .45s cubic-bezier(.2,.9,.3,1) both;}
.corner{position:absolute;width:14px;height:14px;}
.flavor{font-size:11px;color:var(--dim);line-height:1.6;margin:0 0 14px;letter-spacing:0.5px;}
.qrow{padding:12px 0; border-top:1px solid rgba(27,58,92,0.35);}
.qtop{display:flex;justify-content:space-between;align-items:baseline;}
.qname{font-size:14px;letter-spacing:1px;font-weight:600;}
.qamt{font-size:12px;}
.barTrack{height:7px;background:#0A1626;border:1px solid var(--line);overflow:hidden;margin-top:6px;}
.barTrack.thin{height:5px;}
.barFill{height:100%;transition:width .4s cubic-bezier(.2,.8,.2,1);}
.qctrls{display:flex;gap:8px;margin-top:6px;align-items:center;}
.stepBtn{background:transparent;border:1px solid var(--line);color:var(--dim);font-family:'Share Tech Mono',monospace;
  font-size:12px;padding:6px 16px;cursor:pointer;letter-spacing:1px;}
.stepBtn:active{transform:translateY(1px);}
.stepBtn:disabled{opacity:.35;}
.hint{font-size:9px;color:var(--dim);margin-left:auto;}
.claimBtn{display:block;width:100%;margin-top:18px;background:transparent;border:1px solid var(--cyan);color:var(--cyan);
  font-family:'Rajdhani',sans-serif;font-weight:700;font-size:15px;letter-spacing:4px;padding:13px 0;cursor:pointer;}
.clearedMsg{text-align:center;color:var(--green);font-size:11px;letter-spacing:2px;margin-top:16px;}
.bang{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border:1.5px solid;
  border-radius:50%;font-size:13px;font-weight:700;font-family:'Share Tech Mono',monospace;}
.winTitleRow{display:flex;align-items:center;gap:10px;margin-bottom:12px;}
.winTitle{font-size:12px;letter-spacing:3px;font-weight:700;}
nav.tabbar{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:460px;display:flex;
  border-top:1px solid var(--line); background:rgba(4,9,18,0.96); backdrop-filter:blur(8px);
  padding-bottom:env(safe-area-inset-bottom); z-index:30;}
.tabBtn{flex:1;background:transparent;border:none;color:var(--dim);font-family:'Rajdhani',sans-serif;font-weight:600;
  font-size:12px;letter-spacing:3px;padding:16px 0 20px;cursor:pointer;}
.tabBtn.active{color:var(--cyan);text-shadow:0 0 10px rgba(63,217,255,0.55);}
.overlay{position:fixed;inset:0;background:rgba(2,5,10,0.8);backdrop-filter:blur(3px);display:flex;align-items:center;
  justify-content:center;z-index:50;padding:24px;}
.alertBox{position:relative;width:100%;max-width:340px;border:1px solid;background:var(--panel);padding:26px 22px 22px;
  animation:alin .35s cubic-bezier(.2,.9,.3,1) both;}
.alertTitle{text-align:center;font-size:15px;letter-spacing:4px;font-weight:700;margin-bottom:12px;}
.alertLine{font-size:12px;color:var(--ice);text-align:center;line-height:1.7;margin:4px 0;}
.logRow{display:flex;gap:10px;padding:8px 0;border-bottom:1px solid rgba(27,58,92,0.33);}
.logDate{font-size:9px;color:var(--dim);min-width:70px;font-family:'Share Tech Mono',monospace;}
.logText{font-size:11px;line-height:1.5;}
.statRow{margin-bottom:12px;}
.statTop{display:flex;justify-content:space-between;margin-bottom:3px;}
.statName{font-size:12px;letter-spacing:3px;color:var(--ice);font-weight:600;}
.statVal{font-size:12px;color:var(--cyan);}
.blink{animation:blink 1.1s steps(2) infinite;}
@keyframes blink{50%{opacity:.25;}}
.pulseCyan{animation:pcy 1.6s ease-in-out infinite;}
@keyframes pcy{0%,100%{box-shadow:0 0 8px rgba(63,217,255,0.2);}50%{box-shadow:0 0 24px rgba(63,217,255,0.55);}}
.pulseRed{animation:prd 1.2s ease-in-out infinite;}
@keyframes prd{0%,100%{box-shadow:0 0 6px rgba(255,59,92,0.13);}50%{box-shadow:0 0 20px rgba(255,59,92,0.4);}}
@keyframes winin{from{opacity:0;transform:translateY(14px) scale(.98);}to{opacity:1;transform:none;}}
@keyframes alin{from{opacity:0;transform:scale(.85);}to{opacity:1;transform:scale(1);}}
.bootPre{opacity:0;}
.bootIn{animation:bootin .6s ease both;}
@keyframes bootin{from{opacity:0;filter:brightness(2) blur(2px);}to{opacity:1;filter:none;}}
@media (prefers-reduced-motion: reduce){.blink,.pulseCyan,.pulseRed,.window,.alertBox,.bootIn{animation:none !important;}}
</style>
</head>
<body>
<div id="app"></div>

<script>
/* ============================================================
   HUNTER PROTOCOL — standalone build (vanilla JS, localStorage)
   ============================================================ */
const C = {
  cyan:"#3FD9FF", cyanDim:"#1E7FA8", ice:"#CFEFFF", dim:"#6C93B0",
  danger:"#FF3B5C", gold:"#F5C542", green:"#43F5A0"
};

const RANKS = [
  { min:40, r:"S", color:C.gold },
  { min:30, r:"A", color:"#FF8A3D" },
  { min:20, r:"B", color:"#B07CFF" },
  { min:10, r:"C", color:C.cyan },
  { min:5,  r:"D", color:C.green },
  { min:1,  r:"E", color:C.dim },
];

const QUEST_DEFS = [
  { id:"pushups", name:"Push-ups", unit:"reps", base:20, perLvl:2,   stat:"STR", step:5 },
  { id:"situps",  name:"Sit-ups",  unit:"reps", base:20, perLvl:2,   stat:"VIT", step:5 },
  { id:"squats",  name:"Squats",   unit:"reps", base:20, perLvl:2,   stat:"AGI", step:5 },
  { id:"run",     name:"Run",     unit:"km",   base:2,  perLvl:0.1, stat:"STA", step:0.5 },
];

const STORE_KEY = "hunter-save-v1";

const todayKey = () => {
  const d = new Date();
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`;
};
const xpForLevel = (lvl) => Math.round(100 * Math.pow(lvl, 1.5));
const rankFor = (lvl) => RANKS.find(r => lvl >= r.min) || RANKS[RANKS.length-1];
const targetFor = (q, lvl) => q.id === "run"
  ? +(q.base + q.perLvl*(lvl-1)).toFixed(1)
  : Math.round(q.base + q.perLvl*(lvl-1));

const freshQuests = (lvl, mult=1) => {
  const o = {};
  QUEST_DEFS.forEach(q => {
    const t = targetFor(q, lvl) * mult;
    o[q.id] = { done:0, target: q.id==="run" ? +t.toFixed(1) : Math.round(t) };
  });
  return o;
};

const defaultSave = () => ({
  level:1, xp:0,
  stats:{ STR:10, VIT:10, AGI:10, STA:10 },
  streak:0, lastDate:todayKey(),
  penaltyDay:false, claimed:false,
  quests: freshQuests(1),
  log: []
});

/* ---------------- state ---------------- */
let save = null;
let tab = "quests";
let alertQ = [];
let booted = false;

function load() {
  let s;
  try {
    const raw = localStorage.getItem(STORE_KEY);
    s = raw ? { ...defaultSave(), ...JSON.parse(raw) } : defaultSave();
  } catch(e) { s = defaultSave(); }
  return s;
}
function persist() {
  try { localStorage.setItem(STORE_KEY, JSON.stringify(save)); } catch(e) { console.error("save failed", e); }
}
function queueAlert(a) { alertQ.push(a); }

function checkRollover() {
  const today = todayKey();
  if (save.lastDate === today) return;
  if (save.claimed) {
    save.streak += 1;
    save.penaltyDay = false;
    save.quests = freshQuests(save.level);
    save.log = [{ d:save.lastDate, t:"Daily quest cleared. Streak continues.", k:"ok" }, ...save.log].slice(0,30);
  } else {
    const drain = Math.round(xpForLevel(save.level) * 0.25);
    save.xp = Math.max(0, save.xp - drain);
    save.streak = 0;
    save.penaltyDay = true;
    save.quests = freshQuests(save.level, 2);
    save.log = [{ d:save.lastDate, t:`Daily quest failed. −${drain} XP. Penalty quest issued (×2 volume).`, k:"bad" }, ...save.log].slice(0,30);
    queueAlert({
      kind:"penalty", title:"PENALTY",
      lines:[
        "You have failed to complete the Daily Quest.",
        `Punishment: −${drain} XP · streak reset to 0.`,
        "A Penalty Quest has been issued: complete DOUBLE volume today to be reinstated."
      ]
    });
  }
  save.claimed = false;
  save.lastDate = today;
  persist();
}

/* ---------------- actions ---------------- */
function bump(qid, dir) {
  const q = QUEST_DEFS.find(x => x.id === qid);
  const cur = save.quests[qid];
  let v = +(cur.done + dir*q.step).toFixed(1);
  v = Math.max(0, Math.min(cur.target, v));
  const wasDone = cur.done >= cur.target;
  cur.done = v;
  if (!wasDone && v >= cur.target) {
    save.stats[q.stat] += 1;
    queueAlert({ kind:"info", title:"OBJECTIVE COMPLETE", lines:[`[${q.name}] cleared.`, `+1 ${q.stat}`] });
  }
  persist();
  render();
}

function claimReward() {
  const gain = save.penaltyDay
    ? Math.round(60 + save.level*12)
    : Math.round(40 + save.level*8) + save.streak*5;
  save.claimed = true;
  save.xp += gain;
  let leveled = 0;
  while (save.xp >= xpForLevel(save.level)) {
    save.xp -= xpForLevel(save.level);
    save.level += 1;
    leveled += 1;
    save.stats.STR += 2; save.stats.VIT += 2; save.stats.AGI += 2; save.stats.STA += 2;
  }
  const wasPenalty = save.penaltyDay;
  if (wasPenalty) save.penaltyDay = false;
  save.log = [{ d:todayKey(), t:`Daily quest complete. +${gain} XP${leveled?` · LEVEL UP ×${leveled}`:""}`, k:"ok" }, ...save.log].slice(0,30);
  queueAlert({ kind:"reward", title:"DAILY QUEST COMPLETE",
    lines:[`Reward: +${gain} XP${wasPenalty?" (penalty cleared — you are reinstated)":""}`] });
  if (leveled) {
    const nr = rankFor(save.level);
    queueAlert({ kind:"levelup", title:"LEVEL UP",
      lines:[`You have reached Level ${save.level}.`, `All stats +${leveled*2}.`, `Current rank: ${nr.r}`] });
  }
  persist();
  render();
}

function popAlert() { alertQ.shift(); render(); }

function hardReset() {
  save = defaultSave();
  persist();
  render();
}

function setTab(t) { tab = t; render(); }

/* ---------------- render ---------------- */
function esc(s){ return String(s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])); }

function cornersHTML(color) {
  return `
    <span class="corner" style="top:-1px;left:-1px;border-top:2px solid ${color};border-left:2px solid ${color};"></span>
    <span class="corner" style="top:-1px;right:-1px;border-top:2px solid ${color};border-right:2px solid ${color};"></span>
    <span class="corner" style="bottom:-1px;left:-1px;border-bottom:2px solid ${color};border-left:2px solid ${color};"></span>
    <span class="corner" style="bottom:-1px;right:-1px;border-bottom:2px solid ${color};border-right:2px solid ${color};"></span>`;
}

function windowHTML({title, bodyHTML, danger=false, bang=true}) {
  const edge = danger ? C.danger : C.cyan;
  return `
  <section class="window" style="border-color:${edge}88;box-shadow:0 0 24px ${edge}22, inset 0 0 40px ${edge}0A;">
    ${cornersHTML(edge)}
    <div class="winTitleRow">
      ${bang ? `<span class="bang blink" style="border-color:${edge};color:${edge};text-shadow:0 0 8px ${edge};">!</span>` : ""}
      <span class="winTitle" style="color:${edge};">${title}</span>
    </div>
    ${bodyHTML}
  </section>`;
}

function questPanelHTML() {
  const allDone = QUEST_DEFS.every(q => save.quests[q.id].done >= save.quests[q.id].target);
  const rows = QUEST_DEFS.map(q => {
    const cur = save.quests[q.id];
    const pct = Math.min(100, (cur.done/cur.target)*100);
    const done = cur.done >= cur.target;
    return `
      <div class="qrow">
        <div class="qtop">
          <span class="qname" style="color:${done?C.green:C.ice};">${done?"✓ ":"· "}${q.name.toUpperCase()}</span>
          <span class="qamt mono" style="color:${done?C.green:C.cyan};">${cur.done}/${cur.target} ${q.unit}</span>
        </div>
        <div class="barTrack"><div class="barFill" style="width:${pct}%;background:${done?C.green:`linear-gradient(90deg, ${C.cyanDim}, ${C.cyan})`};box-shadow:0 0 10px ${done?C.green:C.cyan}66;"></div></div>
        <div class="qctrls">
          <button class="stepBtn" onclick="bump('${q.id}',-1)">−${q.step}</button>
          <button class="stepBtn" style="border-color:${C.cyan};color:${C.cyan};" onclick="bump('${q.id}',1)" ${done?"disabled":""}>+${q.step}</button>
          <span class="hint mono">+1 ${q.stat} on clear</span>
        </div>
      </div>`;
  }).join("");

  const body = `
    <p class="flavor">${save.penaltyDay
      ? "Complete the doubled regimen to be reinstated. The System is watching."
      : "Complete all objectives before 00:00 to receive rewards."}</p>
    ${rows}`;

  let extra = "";
  if (allDone && !save.claimed) {
    extra = `<button class="claimBtn pulseCyan" onclick="claimReward()">▸ CLAIM REWARD</button>`;
  } else if (save.claimed) {
    extra = `<div class="clearedMsg">✓ QUEST CLEARED — RETURN TOMORROW, HUNTER</div>`;
  }

  return windowHTML({
    title: save.penaltyDay ? "PENALTY QUEST — TRAINING (×2)" : "DAILY QUEST — TRAINING",
    bodyHTML: body,
    danger: save.penaltyDay
  }) + extra;
}

function statusPanelHTML() {
  const rank = rankFor(save.level);
  const need = xpForLevel(save.level);
  const pct = Math.min(100, (save.xp/need)*100);
  const maxStat = Math.max(...Object.values(save.stats), 30);
  const statRows = Object.entries(save.stats).map(([k,v]) => `
    <div class="statRow">
      <div class="statTop"><span class="statName">${k}</span><span class="statVal mono">${v}</span></div>
      <div class="barTrack thin"><div class="barFill" style="width:${Math.min(100,(v/maxStat)*100)}%;background:${C.cyanDim};"></div></div>
    </div>`).join("");

  const idx = RANKS.findIndex(x => x.r === rank.r);
  const nextRankLine = rank.r === "S" ? "MAX RANK ACHIEVED" : `RANK ${RANKS[idx-1].r} AT LEVEL ${RANKS[idx-1].min}`;

  const body = `
    <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:4px;">
      <div>
        <div style="font-size:10px;letter-spacing:2px;color:${C.dim};">LEVEL</div>
        <div style="font-size:44px;font-weight:700;color:${C.ice};line-height:1;text-shadow:0 0 20px ${C.cyan}66;">${save.level}</div>
      </div>
      <div style="text-align:right;">
        <div style="font-size:10px;letter-spacing:2px;color:${C.dim};">STREAK</div>
        <div style="font-size:26px;font-weight:700;color:${save.streak>0?C.gold:C.dim};">${save.streak} <span style="font-size:11px;">days</span></div>
      </div>
    </div>
    <div style="margin-bottom:18px;">
      <div style="display:flex;justify-content:space-between;margin-bottom:4px;">
        <span class="mono" style="font-size:9px;color:${C.dim};letter-spacing:2px;">EXPERIENCE</span>
        <span class="mono" style="font-size:10px;color:${C.cyan};">${save.xp} / ${need}</span>
      </div>
      <div class="barTrack"><div class="barFill" style="width:${pct}%;background:linear-gradient(90deg, ${C.cyanDim}, ${C.cyan});box-shadow:0 0 10px ${C.cyan}66;"></div></div>
    </div>
    ${statRows}
    <div style="margin-top:16px;padding-top:12px;border-top:1px solid ${C.dim}33;display:flex;justify-content:space-between;">
      <span style="font-size:10px;letter-spacing:2px;color:${C.dim};">NEXT RANK</span>
      <span class="mono" style="font-size:10px;color:${rank.color};">${nextRankLine}</span>
    </div>`;

  return windowHTML({ title:"STATUS WINDOW", bodyHTML: body, bang:false });
}

function logPanelHTML() {
  const rows = save.log.length === 0
    ? `<p class="flavor">No records yet. Clear your first Daily Quest to begin your history.</p>`
    : save.log.map(e => `
        <div class="logRow">
          <span class="logDate">${e.d}</span>
          <span class="logText" style="color:${e.k==="bad"?C.danger:C.ice};">${esc(e.t)}</span>
        </div>`).join("");

  return windowHTML({ title:"SYSTEM LOG", bodyHTML: rows, bang:false }) + `
    <div style="margin-top:20px;text-align:center;">
      <button class="stepBtn" style="border-color:${C.danger}66;color:${C.danger}AA;" onclick="askReset()">RESET SAVE DATA</button>
      <div id="resetConfirm"></div>
    </div>`;
}

let resetConfirming = false;
function askReset() { resetConfirming = true; render(); }
function cancelReset() { resetConfirming = false; render(); }

function alertOverlayHTML() {
  if (alertQ.length === 0) return "";
  const a = alertQ[0];
  const color = a.kind === "penalty" ? C.danger : a.kind === "levelup" ? C.gold : C.cyan;
  const lines = a.lines.map(l => `<p class="alertLine">${esc(l)}</p>`).join("");
  return `
  <div class="overlay">
    <div class="alertBox" style="border-color:${color};box-shadow:0 0 40px ${color}44, inset 0 0 30px ${color}11;">
      ${cornersHTML(color)}
      <div style="text-align:center;margin-bottom:14px;">
        <span class="bang blink" style="width:34px;height:34px;font-size:20px;border-color:${color};color:${color};text-shadow:0 0 10px ${color};">!</span>
      </div>
      <div class="alertTitle" style="color:${color};text-shadow:0 0 12px ${color}66;">${a.title}</div>
      ${lines}
      <button class="claimBtn" style="border-color:${color};color:${color};margin-top:18px;" onclick="popAlert()">▸ ACKNOWLEDGE</button>
    </div>
  </div>`;
}

function rankBadgeHTML() {
  const rank = rankFor(save.level);
  return `
  <div class="rankBadge" style="border-color:${rank.color};box-shadow:0 0 18px ${rank.color}44, inset 0 0 12px ${rank.color}22;">
    <span class="rankLbl">RANK</span>
    <span class="rankVal" style="color:${rank.color};text-shadow:0 0 14px ${rank.color}88;">${rank.r}</span>
  </div>`;
}

function countdownStripHTML() {
  const mid = new Date(); mid.setHours(24,0,0,0);
  const msLeft = mid.getTime() - Date.now();
  const hh = String(Math.floor(msLeft/3600000)).padStart(2,"0");
  const mm = String(Math.floor((msLeft%3600000)/60000)).padStart(2,"0");
  const ss = String(Math.floor((msLeft%60000)/1000)).padStart(2,"0");
  const urgent = msLeft < 3*3600000 && !save.claimed;
  return `
  <div id="countStrip" class="countStrip ${urgent?'pulseRed':''}" style="border-color:${urgent?C.danger:'#1B3A5C'};">
    <span class="countLbl mono">${save.claimed ? "QUEST CLEARED — RESETS IN" : "TIME REMAINING"}</span>
    <span id="countVal" class="countVal mono" style="color:${urgent?C.danger:C.ice};text-shadow:0 0 12px ${urgent?C.danger:C.cyan}55;">${hh}:${mm}:${ss}</span>
    ${!save.claimed ? `<span class="countWarn mono" style="color:${urgent?C.danger:C.dim};">FAILURE = PENALTY</span>` : ""}
  </div>`;
}

function render() {
  checkRollover();
  const rank = rankFor(save.level);

  let panelHTML = "";
  if (tab === "quests") panelHTML = questPanelHTML();
  else if (tab === "status") panelHTML = statusPanelHTML();
  else if (tab === "log") {
    panelHTML = logPanelHTML();
  }

  const app = document.getElementById("app");
  app.innerHTML = `
    <div id="frame" class="${booted ? 'bootIn' : 'bootPre'}">
      <div class="scan"></div>
      <header class="hdr">
        <div>
          <div class="eyebrow">HUNTER PROTOCOL v1.0</div>
          <div class="title">STATUS: <span style="color:${save.penaltyDay?C.danger:C.cyan};">${save.penaltyDay?"PENALTY":"ACTIVE"}</span></div>
        </div>
        ${rankBadgeHTML()}
      </header>
      ${countdownStripHTML()}
      <main class="body">${panelHTML}</main>
      <nav class="tabbar">
        <button class="tabBtn ${tab==='quests'?'active':''}" onclick="setTab('quests')">${tab==='quests'?'[ QUESTS ]':'QUESTS'}</button>
        <button class="tabBtn ${tab==='status'?'active':''}" onclick="setTab('status')">${tab==='status'?'[ STATUS ]':'STATUS'}</button>
        <button class="tabBtn ${tab==='log'?'active':''}" onclick="setTab('log')">${tab==='log'?'[ LOG ]':'LOG'}</button>
      </nav>
      ${alertOverlayHTML()}
    </div>`;

  if (tab === "log") {
    const holder = document.getElementById("resetConfirm");
    if (holder && resetConfirming) {
      holder.innerHTML = `
        <div style="display:flex;gap:10px;justify-content:center;margin-top:10px;">
          <button class="stepBtn" style="border-color:${C.danger};color:${C.danger};" onclick="hardReset(); resetConfirming=false;">CONFIRM WIPE</button>
          <button class="stepBtn" onclick="cancelReset()">CANCEL</button>
        </div>`;
    }
  }
}

/* lightweight per-second countdown tick without full re-render */
setInterval(() => {
  checkRollover();
  const stripCheck = document.getElementById("countStrip");
  if (!stripCheck) return;
  const mid = new Date(); mid.setHours(24,0,0,0);
  const msLeft = mid.getTime() - Date.now();
  const hh = String(Math.floor(msLeft/3600000)).padStart(2,"0");
  const mm = String(Math.floor((msLeft%3600000)/60000)).padStart(2,"0");
  const ss = String(Math.floor((msLeft%60000)/1000)).padStart(2,"0");
  const urgent = msLeft < 3*3600000 && !save.claimed;
  const valEl = document.getElementById("countVal");
  if (valEl) valEl.textContent = `${hh}:${mm}:${ss}`;
  stripCheck.classList.toggle("pulseRed", urgent);
  stripCheck.style.borderColor = urgent ? C.danger : "#1B3A5C";
  if (valEl) { valEl.style.color = urgent ? C.danger : C.ice; }
  // if an alert just got queued by rollover mid-session, do a full render
  if (alertQ.length > 0 && !document.querySelector(".overlay")) render();
}, 1000);

/* ---------------- boot ---------------- */
save = load();
checkRollover();
render();
setTimeout(() => { booted = true; render(); }, 350);

/* register service worker for offline installability, if hosted (not file://) */
if ("serviceWorker" in navigator && location.protocol !== "file:") {
  window.addEventListener("load", () => {
    navigator.serviceWorker.register("service-worker.js").catch(()=>{});
  });
}
</script>
</body>
</html>
